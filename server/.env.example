# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=copilot
DB_USERNAME=postgres
DB_PASSWORD=your_db_password

# JWT (generate with: openssl rand -base64 64)
JWT_SECRET=your_jwt_secret_min_256bit
JWT_EXPIRATION_MS=604800000

# AI - Embedding (DashScope)
AI_DASHSCOPE_API_KEY=your_dashscope_api_key

# AI - Chat (DeepSeek)
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_CHAT_MODEL=deepseek-chat

# Optional
APP_UPLOAD_MAX_FILE_SIZE=20MB
APP_UPLOAD_MAX_REQUEST_SIZE=25MB
APP_AI_RETRIEVAL_TOP_K=3
APP_AI_EMBEDDING_BATCH_SIZE=10
