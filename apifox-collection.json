{
  "info": {
    "_postman_id": "0f0d6d32-96ef-4ab2-9f17-b11c58ea7d73",
    "name": "Enterprise Knowledge Copilot V0 接口示例",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "可直接导入 Apifox 的当前 V0 后端接口请求示例。"
  },
  "item": [
    {
      "name": "认证接口",
      "item": [
        {
          "name": "注册",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"name\": \"test-user\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "注册新用户，并返回 JWT token。"
          }
        },
        {
          "name": "登录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "使用邮箱和密码登录，并返回 JWT token。"
          }
        }
      ]
    },
    {
      "name": "知识库接口",
      "item": [
        {
          "name": "创建知识库",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"我的知识库\",\n  \"description\": \"用于测试当前 V0 接口\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/knowledge-bases",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "knowledge-bases"
              ]
            },
            "description": "为当前登录用户创建一个知识库。"
          }
        },
        {
          "name": "查询知识库列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/knowledge-bases",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "knowledge-bases"
              ]
            },
            "description": "查询当前用户拥有的知识库列表。"
          }
        },
        {
          "name": "查询知识库详情",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/knowledge-bases/{{knowledgeBaseId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "knowledge-bases",
                "{{knowledgeBaseId}}"
              ]
            },
            "description": "根据 ID 查询单个知识库详情。"
          }
        }
      ]
    },
    {
      "name": "文档接口",
      "item": [
        {
          "name": "上传文档",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/knowledge-bases/{{knowledgeBaseId}}/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "knowledge-bases",
                "{{knowledgeBaseId}}",
                "documents"
              ]
            },
            "description": "向指定知识库上传 PDF、DOCX 或 Markdown 文档。"
          }
        },
        {
          "name": "查询文档列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/knowledge-bases/{{knowledgeBaseId}}/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "knowledge-bases",
                "{{knowledgeBaseId}}",
                "documents"
              ]
            },
            "description": "查询指定知识库下的文档列表。"
          }
        },
        {
          "name": "查询文档状态",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/documents/{{documentId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "documents",
                "{{documentId}}",
                "status"
              ]
            },
            "description": "根据文档 ID 查询当前状态。"
          }
        }
      ]
    },
    {
      "name": "会话接口",
      "item": [
        {
          "name": "创建会话",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"knowledgeBaseId\": {{knowledgeBaseId}},\n  \"title\": \"第一次问答会话\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/chat/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat",
                "sessions"
              ]
            },
            "description": "在指定知识库下创建一个聊天会话。"
          }
        },
        {
          "name": "查询会话列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/chat/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat",
                "sessions"
              ]
            },
            "description": "查询当前用户的会话列表。"
          }
        },
        {
          "name": "发送用户消息",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"你好，这是一条测试消息\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/chat/sessions/{{sessionId}}/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat",
                "sessions",
                "{{sessionId}}",
                "messages"
              ]
            },
            "description": "向指定会话写入一条用户消息。"
          }
        },
        {
          "name": "查询消息列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/chat/sessions/{{sessionId}}/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat",
                "sessions",
                "{{sessionId}}",
                "messages"
              ]
            },
            "description": "查询指定会话下的消息列表。"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "knowledgeBaseId",
      "value": "1"
    },
    {
      "key": "documentId",
      "value": "1"
    },
    {
      "key": "sessionId",
      "value": "1"
    }
  ]
}
